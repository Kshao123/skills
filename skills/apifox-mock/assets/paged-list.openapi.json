{
  "_comment": "Paged list + detail mock. Copy to the system temp directory, replace every <placeholder> and the Example* names, then import — scripts/apifox.mjs strips _comment and _note keys for you. Envelope is Spring Data Page; other envelopes are in references/examples.md.",
  "openapi": "3.0.1",
  "info": {
    "title": "<feature name>",
    "version": "1.0.0"
  },
  "tags": [{ "name": "<folder>/<subfolder>" }],
  "paths": {
    "/getExampleList": {
      "get": {
        "summary": "getExampleList",
        "description": "<feature name> - paged list",
        "tags": ["<folder>/<subfolder>"],
        "x-apifox-folder": "<folder>/<subfolder>",
        "x-apifox-status": "developing",
        "deprecated": false,
        "parameters": [
          { "name": "page", "in": "query", "description": "page index, zero-based", "required": false, "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "description": "rows per page", "required": false, "schema": { "type": "integer", "default": 10 } },
          { "name": "sort", "in": "query", "description": "sort expression, e.g. createTime,DESC", "required": false, "schema": { "type": "string" } },
          {
            "_note": "One parameter per filter field the UI sends. Delete or duplicate this entry.",
            "name": "exampleCode",
            "in": "query",
            "description": "<what this filters on>",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "paged data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExamplePage" }
              }
            }
          }
        },
        "security": []
      }
    },
    "/getExampleDetail": {
      "get": {
        "summary": "getExampleDetail",
        "description": "<feature name> - detail",
        "tags": ["<folder>/<subfolder>"],
        "x-apifox-folder": "<folder>/<subfolder>",
        "x-apifox-status": "developing",
        "deprecated": false,
        "parameters": [
          { "name": "exampleId", "in": "query", "description": "primary key", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExampleVO" }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "ExamplePage": {
        "type": "object",
        "title": "ExamplePage",
        "description": "Spring Data Page envelope. Every counter is pinned so it agrees with the 10 rows. For page 1 of 4 set totalElements 35 / totalPages 4; for an empty state set minItems/maxItems 0, numberOfElements/totalElements/totalPages 0, empty true.",
        "properties": {
          "content": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ExampleVO" },
            "minItems": 10,
            "maxItems": 10
          },
          "number": { "type": "integer", "description": "current page, zero-based", "x-apifox-mock": "0" },
          "size": { "type": "integer", "description": "rows per page", "x-apifox-mock": "10" },
          "numberOfElements": { "type": "integer", "description": "rows on this page", "x-apifox-mock": "10" },
          "totalElements": { "type": "integer", "description": "rows across all pages", "x-apifox-mock": "10" },
          "totalPages": { "type": "integer", "description": "page count", "x-apifox-mock": "1" },
          "empty": { "type": "boolean", "description": "true when content is empty", "x-apifox-mock": "false" }
        },
        "required": ["content", "number", "size", "numberOfElements", "totalElements", "totalPages", "empty"]
      },
      "ExampleVO": {
        "type": "object",
        "title": "ExampleVO",
        "description": "One row. Every common field kind appears once; keep the ones the page shows, delete the rest.",
        "properties": {
          "exampleId": { "type": "integer", "description": "primary key", "x-apifox-mock": "@integer(100000,999999)" },
          "exampleCode": { "type": "string", "description": "business code", "x-apifox-mock": "EX@integer(10000,99999)" },
          "exampleName": { "type": "string", "description": "name", "x-apifox-mock": "@ctitle(3,6)有限公司" },
          "supplier": {
            "_note": "Nested object for a bound lov/lookup: return it nested only, never also flattened.",
            "type": "object",
            "description": "related object",
            "properties": {
              "supplierCode": { "type": "string", "x-apifox-mock": "SUP@integer(10000,99999)" },
              "supplierName": { "type": "string", "x-apifox-mock": "@ctitle(3,6)有限公司" }
            },
            "required": ["supplierCode", "supplierName"]
          },
          "statusCode": { "type": "string", "description": "status code", "enum": ["1", "2", "3"], "x-apifox-mock": "@pick(['1','2','3'])" },
          "enabledFlag": { "type": "integer", "description": "1 yes / 0 no", "enum": [0, 1], "x-apifox-mock": "@pick([0,1])" },
          "amount": { "type": "number", "description": "money, 2 decimals", "x-apifox-mock": "@float(1000,9999999,2,2)" },
          "totalQuantity": {
            "_note": "Upstream of a computed column: ranges keep passedQuantity <= totalQuantity so a difference or ratio is always legal.",
            "type": "integer",
            "description": "total",
            "x-apifox-mock": "@integer(80,100)"
          },
          "passedQuantity": { "type": "integer", "description": "part of total", "x-apifox-mock": "@integer(60,80)" },
          "statisticsMonth": { "type": "string", "description": "month YYYY-MM", "x-apifox-mock": "@pick(['2026-06','2026-07','2026-08','2026-09'])" },
          "creatorAccount": { "type": "string", "description": "created by", "x-apifox-mock": "@pick(['zhangsan','lisi','wangwu','zhaoliu'])" },
          "createTime": {
            "_note": "Never a bare @datetime() — it emits 1998 and future dates. Regenerate these from today's date.",
            "type": "string",
            "description": "creation time",
            "x-apifox-mock": "@pick(['2026-09-01 09:12:30','2026-08-18 10:05:44','2026-07-30 16:41:02','2026-06-11 08:30:00'])"
          },
          "remark": { "type": "string", "description": "remark", "x-apifox-mock": "@ctitle(4,10)" }
        },
        "required": ["exampleId", "exampleCode"]
      }
    }
  },
  "servers": [],
  "security": []
}
